{
  "schema_version": 6,
  "_comment": "Trader blueprint distribution. Each trader has an explicit BPR weapon-family assortment derived from the vanilla trader weapon generators. Progression stages only control blueprint-tier availability.",
  "defaults": {
    "start_index": 86,
    "trader_category": "EItemGenerationCategory::SubItemGenerator",
    "pool_category": "EItemGenerationCategory::Attach",
    "allow_same_category_generation": true,
    "subgenerator_chance": 1,
    "tier_chance_by_tier": {
      "1": 1,
      "2": 0.45,
      "3": 0.2
    },
    "stock_count_by_player_rank": {
      "Newbie": { "min": 2, "max": 3 },
      "Experienced": { "min": 2, "max": 3 },
      "Veteran": { "min": 2, "max": 3 },
      "Master": { "min": 2, "max": 3 }
    }
  },
  "stage_rules": {
    "_comment": "Stages control blueprint-tier progression only. Weapon-family availability is configured per trader from the vanilla weapon assortment.",
    "1": {
      "blueprint_tier_chance_by_tier": { "1": 1, "2": 0.15, "3": 0 }
    },
    "2": {
      "blueprint_tier_chance_by_tier": { "1": 1, "2": 0.5, "3": 0 }
    },
    "3": {
      "blueprint_tier_chance_by_tier": { "1": 0.35, "2": 1, "3": 0.15 }
    },
    "4": {
      "blueprint_tier_chance_by_tier": { "1": 0.1, "2": 1, "3": 0.45 }
    },
    "5": {
      "blueprint_tier_chance_by_tier": { "1": 0, "2": 0.5, "3": 1 }
    },
    "6": {
      "blueprint_tier_chance_by_tier": { "1": 0, "2": 0.25, "3": 1 }
    }
  },
