{
  "schema_version": 5,
  "_comment": "Trader blueprint distribution. Traders draw a small random stock from progression windows. Weapon-family progression and blueprint-tier progression are both controlled by trader stage.",
  "defaults": {
    "start_index": 86,
    "trader_category": "EItemGenerationCategory::SubItemGenerator",
    "pool_category": "EItemGenerationCategory::Attach",
    "allow_same_category_generation": true,
    "subgenerator_chance": 1,
    "tier_chance_by_tier": {
      "1": 1,
      "2": 0.45,
      "3": 0.2
    },
    "stock_count_by_player_rank": {
      "Newbie": {
        "min": 2,
        "max": 3
      },
      "Experienced": {
        "min": 2,
        "max": 3
      },
      "Veteran": {
        "min": 2,
        "max": 3
      },
      "Master": {
        "min": 2,
        "max": 3
      }
    }
  },
  "stage_rules": {
    "_comment": "Weapon pools remain non-cumulative from stage 3 onward. Blueprint tiers now progress separately so early traders no longer expose every tier of an eligible weapon family.",
    "1": {
      "weapon_ranks": [
        "Newbie"
      ],
      "blueprint_tier_chance_by_tier": {
        "1": 1,
        "2": 0.15,
        "3": 0
      }
    },
    "2": {
      "weapon_ranks": [
        "Newbie",
        "Experienced"
      ],
      "blueprint_tier_chance_by_tier": {
        "1": 1,
        "2": 0.5,
        "3": 0
      }
    },
    "3": {
      "weapon_ranks": [
        "Experienced"
      ],
      "blueprint_tier_chance_by_tier": {
        "1": 0.35,
        "2": 1,
        "3": 0.15
      }
    },
    "4": {
      "weapon_ranks": [
        "Experienced",
        "Veteran"
      ],
      "blueprint_tier_chance_by_tier": {
        "1": 0.1,
        "2": 1,
        "3": 0.45
      }
    },
    "5": {
      "weapon_ranks": [
        "Veteran"
      ],
      "blueprint_tier_chance_by_tier": {
        "1": 0,
        "2": 0.5,
        "3": 1
      }
    },
    "6": {
      "weapon_ranks": [
        "Veteran"
      ],
      "blueprint_tier_chance_by_tier": {
        "1": 0,
        "2": 0.25,
        "3": 1
      }
    }
  },
  "focus_groups": {
    "_comment": "Optional hard family filters applied after the stage progression window.",
    "nato": [
      "M16",
      "G37",
      "Fora",
      "Fora230",
      "Kharod",
      "M701",
      "GP3A",
      "Arev"
    ],
    "soviet": [
      "PM",
      "AKU",
      "AK74",
      "Gvintar",
      "Lavina",
      "Dnipro",
      "PKP",
      "SVDM",
      "SVU",
      "APB"
    ]
  },
