{
  "schema_version": 3,
  "_comment": "Trader blueprint distribution. Traders draw a limited random stock from progression windows instead of exposing every eligible blueprint.",
  "defaults": {
    "start_index": 86,
    "trader_category": "EItemGenerationCategory::SubItemGenerator",
    "pool_category": "EItemGenerationCategory::Attach",
    "allow_same_category_generation": true,
    "subgenerator_chance": 1,
    "pool_item_chance": 1,
    "tier_cap_by_player_rank": {
      "Newbie": 1,
      "Experienced": 2,
      "Veteran": 3,
      "Master": 3
    },
    "stock_count_by_player_rank": {
      "Newbie": {
        "min": 2,
        "max": 3
      },
      "Experienced": {
        "min": 3,
        "max": 4
      },
      "Veteran": {
        "min": 4,
        "max": 5
      },
      "Master": {
        "min": 4,
        "max": 5
      }
    }
  },
  "stage_rules": {
    "_comment": "Progression windows are intentionally non-cumulative from stage 3 onward so older weapon families remain tied to earlier traders.",
    "1": {
      "weapon_ranks": [
        "Newbie"
      ]
    },
    "2": {
      "weapon_ranks": [
        "Newbie",
        "Experienced"
      ]
    },
    "3": {
      "weapon_ranks": [
        "Experienced"
      ]
    },
    "4": {
      "weapon_ranks": [
        "Experienced",
        "Veteran"
      ]
    },
    "5": {
      "weapon_ranks": [
        "Veteran"
      ]
    },
    "6": {
      "weapon_ranks": [
        "Veteran"
      ]
    }
  },
  "focus_groups": {
    "_comment": "Optional hard family filters applied after the stage progression window.",
    "nato": [
      "M16",
      "G37",
      "Fora",
      "Fora230",
      "Kharod",
      "M701",
      "GP3A",
      "Arev"
    ],
    "soviet": [
      "PM",
      "AKU",
      "AK74",
      "Gvintar",
      "Lavina",
      "Dnipro",
      "PKP",
      "SVDM",
      "SVU",
      "APB"
    ]
  },
  "traders": {
    "Zalissya": {
      "generator": "TraderZalesie_TradeItemGenerator",
      "region": "Lesser Zone",
      "progression_stage": 1,
      "note": "Newbie-family pool. Higher blueprint tiers become available when the player rank increases."
    },
    "Terikon": {
      "generator": "TraderTerikon_TradeItemGenerator",
      "region": "Garbage / Slag Heap",
      "progression_stage": 2,
      "note": "Mixed Newbie and Experienced pool."
    },
    "NewbieVillage": {
      "generator": "NewbeeVillageTrader_TradeItemGenerator",
      "region": "Cordon / Rookie Village",
      "progression_stage": 2,
      "note": "Mixed Newbie and Experienced pool."
    },
    "Asylum": {
      "generator": "AsylumTrader_TradeItemGenerator",
      "region": "Wild Island / Shelter",
      "progression_stage": 2,
      "note": "Mixed Newbie and Experienced pool."
    },
    "Ikar": {
      "generator": "IkarTrader_TradeItemGenerator",
      "region": "Zaton / Icarus",
      "progression_stage": 2,
      "note": "Mixed Newbie and Experienced pool."
    },
    "Sultansk": {
      "generator": "SultanskTrader_TradeItemGenerator",
      "region": "Zaton / Sultansk",
      "progression_stage": 2,
      "note": "Mixed Newbie and Experienced pool."
    },
    "Shevchenko": {
      "generator": "ShevchenkoTrader_TradeItemGenerator",
      "region": "Zaton / Shevchenko",
      "progression_stage": 2,
      "note": "Mixed Newbie and Experienced pool."
    },
    "ChemicalPlant": {
      "generator": "TraderChemicalPlant_TradeItemGenerator",
      "region": "Chemical Plant",
      "progression_stage": 2,
      "note": "Mixed Newbie and Experienced pool."
    },
    "CementPlant": {
      "generator": "CementPlantTrader_TradeItemGenerator",
      "region": "Cement Factory",
      "progression_stage": 3,
      "note": "Experienced-family pool; Newbie families are intentionally cut here."
    },
    "RostokNATO": {
      "generator": "RostokTraderNato_TradeItemGenerator",
      "region": "Rostok",
      "progression_stage": 3,
      "focus": "nato",
      "note": "Experienced NATO-family pool."
    },
    "RostokSoviet": {
      "generator": "RostokTraderSoviet_TradeItemGenerator",
      "region": "Rostok",
      "progression_stage": 3,
      "focus": "soviet",
      "note": "Experienced Soviet-family pool."
    },
    "Malakhit": {
      "generator": "MalakhitTrader_TradeItemGenerator",
      "region": "STC Malachite",
      "progression_stage": 4,
      "note": "Experienced and Veteran-family pool."
    },
    "RedForest": {
      "generator": "RedForestTrader_TradeItemGenerator",
      "region": "Red Forest",
      "progression_stage": 4,
      "note": "Experienced and Veteran-family pool."
    },
    "Yanov": {
      "generator": "YanovTrader_TradeItemGenerator",
      "region": "Yaniv",
      "progression_stage": 5,
      "note": "Veteran-family pool; older families stay with earlier traders."
    },
    "Pripyat": {
      "generator": "PripyatTrader_TradeItemGenerator",
      "region": "Pripyat",
      "progression_stage": 6,
      "note": "Veteran-family endgame pool; not a global catch-all."
    }
  }
}
