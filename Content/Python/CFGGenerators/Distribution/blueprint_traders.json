{
  "schema_version": 2,
  "_comment": "Trader blueprint distribution derived from weapon_progression.json. Trader JSON now stores only trader progression/focus metadata; blueprint lists are generated.",
  "defaults": {
    "category": "EItemGenerationCategory::Attach",
    "player_ranks": [
      "ERank::Newbie",
      "ERank::Experienced",
      "ERank::Veteran",
      "ERank::Master"
    ],
    "chance": 1,
    "min_count": 1,
    "max_count": 1,
    "min_durability": 1,
    "max_durability": 1,
    "allow_same_category_generation": true
  },
  "stage_rules": {
    "_comment": "Trader progression is cumulative. max_blueprint_tier caps which blueprint tiers are sold for families available at that stage.",
    "1": {
      "max_weapon_rank": "Newbie",
      "max_blueprint_tier": 1
    },
    "2": {
      "max_weapon_rank": "Experienced",
      "max_blueprint_tier": 2
    },
    "3": {
      "max_weapon_rank": "Experienced",
      "max_blueprint_tier": 3
    },
    "4": {
      "max_weapon_rank": "Veteran",
      "max_blueprint_tier": 2
    },
    "5": {
      "max_weapon_rank": "Veteran",
      "max_blueprint_tier": 3
    },
    "6": {
      "max_weapon_rank": "Veteran",
      "max_blueprint_tier": 3,
      "catch_all": true
    }
  },
  "focus_groups": {
    "_comment": "Optional soft filters. Omit focus on a trader to sell all families unlocked for its stage.",
    "nato": [
      "M16",
      "G37",
      "Fora",
      "Fora230",
      "Kharod",
      "M701",
      "GP3A",
      "Arev"
    ],
    "soviet": [
      "PM",
      "AKU",
      "AK74",
      "Gvintar",
      "Lavina",
      "Dnipro",
      "PKP",
      "SVDM",
      "SVU",
      "APB"
    ]
  },
  "traders": {
    "Zalissya": {
      "generator": "TraderZalesie_TradeItemGenerator",
      "region": "Lesser Zone",
      "progression_stage": 1,
      "note": "Starting trader; basic early-game inventory."
    },
    "Terikon": {
      "generator": "TraderTerikon_TradeItemGenerator",
      "region": "Garbage / Slag Heap",
